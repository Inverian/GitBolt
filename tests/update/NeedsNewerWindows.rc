// A version resource like the NSIS installer's (cmake/Packaging.cmake),
// whose GitBoltMinimumWindows no Windows meets: test_update_installer's
// exe, copied as an installer, stands in for one for a newer Windows.
#include <winver.h>

1 VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "GitBolt test\0"
            VALUE "ProductVersion", "0.1.1\0"
            VALUE "GitBoltMinimumWindows", "10.0.99999\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
